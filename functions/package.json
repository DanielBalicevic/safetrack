{
  "name": "safetrack-functions",
  "description": "SafeTrack Cloud Functions: telemetry ingestion, geofencing and notifications",
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.js",
    "test:integration": "firebase emulators:exec --only functions,firestore \"node --test test/integration/processTelemetry.integration.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "private": true
}

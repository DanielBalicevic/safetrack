# Copy to functions/.env. Loaded automatically by firebase-functions.

# Shared key sent by the device in the X-Device-Key header.
# Generate one with: openssl rand -hex 32
DEVICE_KEY=change-me

# Telegram notifications (optional). Run `node tools/telegram-setup.js <TOKEN>`
# to fill these in. users/{uid}.telegramChatId overrides TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Geolocation API key, used to resolve Wi-Fi scans indoors.
# Use a dedicated key restricted to the Geolocation API.
GEOLOCATION_API_KEY=
